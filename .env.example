# --- Chạy trên EC2 / production ---
# Sao chép thành file .env trên server: cp .env.example .env && nano .env
# KHÔNG commit file .env (đã có trong .gitignore).

# Môi trường Node (khuyến nghị production)
NODE_ENV=production

# Cổng API (nginx/proxy thường forward tới đây)
PORT=3005

# MongoDB — Atlas: dùng chuỗi mongodb+srv://... từ Atlas → Connect → Drivers
# Thay <user>, <password>, cluster và tên DB cho đúng; password URL-encode nếu có ký tự đặc biệt
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Bí mật ký JWT — chuỗi ngẫu nhiên dài (≥ 32 ký tự), giữ bí mật, đổi là hết hiệu lực token cũ
# Tạo nhanh (trên máy có openssl): openssl rand -base64 48
JWT_SECRET=thay-bang-chuoi-bi-mat-rat-dai-khong-dung-chung-voi-repo

# Tab Xu hướng: bật để đọc snapshot demo (snapshotType=demo), tắt để dùng snapshot production
TRENDS_DEMO_MODE=false

# Tuỳ chọn khi seed demo: đường dẫn CSV baseline
# SNAPSHOT_BASELINE_CSV=./scripts/data/trend-demo-baseline.csv
